{
  "name": "advanced-neural-architecture",
  "displayName": "ANA MAX - Advanced Neural Architecture",
  "description": "Windows-first MCP runtime with 64 loaded tools for local agent IDE workflows, desktop awareness, runtime diagnostics, and verification.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture.git"
  },
  "homepage": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture#readme",
  "bugs": {
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "AI",
    "MCP",
    "Windows",
    "Automation",
    "Desktop Awareness",
    "UI Testing",
    "Agent IDE",
    "Local First",
    "Neural Architecture"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "scripts": {
    "check": "node --check src/extension.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1"
  },
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "ANA MAX",
      "properties": {
        "anaMax.mcpApiKey": {
          "type": "string",
          "default": "change-me",
          "description": "Bearer token sent to the local ANA MAX MCP server. Must match MCP_API_KEY or ANA_MCP_KEY."
        },
        "anaMax.mcpHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "ANA MAX MCP server host."
        },
        "anaMax.mcpPort": {
          "type": "number",
          "default": 8765,
          "description": "ANA MAX MCP server port."
        }
      }
    },
    "commands": [
      {
        "command": "anaMax.startMCP",
        "title": "ANA MAX: Start MCP Server",
        "icon": "$(play)"
      },
      {
        "command": "anaMax.stopMCP",
        "title": "ANA MAX: Stop MCP Server",
        "icon": "$(stop)"
      },
      {
        "command": "anaMax.callTool",
        "title": "ANA MAX: Call Tool",
        "icon": "$(tools)"
      },
      {
        "command": "anaMax.checkLicense",
        "title": "ANA MAX: Check License Status",
        "icon": "$(key)"
      },
      {
        "command": "anaMax.openDocs",
        "title": "ANA MAX: Open Documentation",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ana-max-container",
          "title": "ANA MAX",
          "icon": "$(brain)"
        }
      ]
    },
    "views": {
      "ana-max-container": [
        {
          "id": "ana-max-status",
          "name": "ANA MAX Status",
          "icon": "$(info)"
        }
      ]
    }
  },
  "publisher": "d4d8176a-bb85-66ef-93dd-a58bc9ddfdad"
}
