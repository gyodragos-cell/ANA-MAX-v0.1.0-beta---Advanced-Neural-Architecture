{
  "name": "advanced-neural-architecture",
  "displayName": "ANA MAX - Advanced Neural Architecture",
  "description": "AI-powered Windows automation with 43+ MCP tools including Vision AI (screenshot + OCR), desktop control, UI testing, and intelligent code operations. Free with optional Pro license.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture.git"
  },
  "homepage": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture#readme",
  "bugs": {
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "AI",
    "MCP",
    "Windows",
    "Automation",
    "Desktop Control",
    "UI Testing",
    "Free",
    "Neural Architecture"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "scripts": {
    "check": "node --check src/extension.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anaMax.startMCP",
        "title": "ANA MAX: Start MCP Server",
        "icon": "$(play)"
      },
      {
        "command": "anaMax.stopMCP",
        "title": "ANA MAX: Stop MCP Server",
        "icon": "$(stop)"
      },
      {
        "command": "anaMax.callTool",
        "title": "ANA MAX: Call Tool",
        "icon": "$(tools)"
      },
      {
        "command": "anaMax.checkLicense",
        "title": "ANA MAX: Check License Status",
        "icon": "$(key)"
      },
      {
        "command": "anaMax.openDocs",
        "title": "ANA MAX: Open Documentation",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ana-max-container",
          "title": "ANA MAX",
          "icon": "$(brain)"
        }
      ]
    },
    "views": {
      "ana-max-container": [
        {
          "id": "ana-max-status",
          "name": "ANA MAX Status",
          "icon": "$(info)"
        }
      ]
    }
  },
  "publisher": "d4d8176a-bb85-66ef-93dd-a58bc9ddfdad"
}
