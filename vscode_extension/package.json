{
  "name": "ana-antigravity-chat",
  "displayName": "ANA MAX Hybrid AI Cockpit",
  "description": "Local-first MCP cockpit for ANA MAX: Codex, Antigravity/Qoder, Windsurf and VS Code-compatible agent IDEs.",
  "version": "1.0.8",
  "publisher": "ana-ai",
  "author": {
    "name": "Dragos / gyodragos-cell with Codex",
    "email": "gyodragos@gmail.com",
    "url": "https://github.com/gyodragos-cell"
  },
  "contributors": [
    {
      "name": "Codex",
      "url": "https://openai.com/codex"
    }
  ],
  "license": "MIT",
  "icon": "assets/ana-max-icon.png",
  "homepage": "https://gyodragos-cell.github.io/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture.git"
  },
  "bugs": {
    "url": "https://github.com/gyodragos-cell/ANA-MAX-v0.1.0-beta---Advanced-Neural-Architecture/issues"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agent-ide",
    "codex",
    "antigravity",
    "qoder",
    "windsurf",
    "vscode",
    "local-ai",
    "windows-automation",
    "qa",
    "debugging",
    "tool-router",
    "desktop-ai",
    "ana-max"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ana.openChat",
        "title": "ANA & Antigravity: Open Cockpit",
        "category": "ANA"
      },
      {
        "command": "ana.callTool",
        "title": "ANA & Antigravity: Call MCP Tool",
        "category": "ANA"
      },
      {
        "command": "ana.showHybridConfig",
        "title": "ANA & Antigravity: Show Hybrid MCP Config",
        "category": "ANA"
      },
      {
        "command": "anaMax.startRuntime",
        "title": "ANA MAX: Start Runtime"
      },
      {
        "command": "anaMax.showHealth",
        "title": "ANA MAX: Show Health"
      },
      {
        "command": "anaMax.runScenario",
        "title": "ANA MAX: Run Scenario"
      },
      {
        "command": "anaMax.executeTool",
        "title": "ANA MAX: Execute Tool"
      },
      {
        "command": "anaMax.inspectRuntime",
        "title": "ANA MAX: Inspect Runtime"
      },
      {
        "command": "anaMax.showRouterDecisions",
        "title": "ANA MAX: Show Router Decisions"
      },
      {
        "command": "anaMax.runRemSleep",
        "title": "ANA MAX: Run REM Sleep"
      },
      {
        "command": "anaMax.showObservability",
        "title": "ANA MAX: Show Observability"
      },
      {
        "command": "anaMax.openDashboard",
        "title": "ANA MAX: Open Dashboard"
      }
    ],
    "configuration": {
      "title": "ANA MAX",
      "properties": {
        "anaMax.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "Keep ANA MAX extension actions in safe-mode."
        },
        "anaMax.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8766/mcp",
          "description": "ANA MAX MCP or runtime endpoint."
        },
        "anaMax.runtimeRoot": {
          "type": "string",
          "default": "",
          "description": "Local ANA MAX runtime root used by the start command. Defaults to the open workspace folder."
        },
        "anaMax.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable path. Defaults to runtimeRoot\\venv\\Scripts\\python.exe."
        },
        "anaMax.runtimePort": {
          "type": "number",
          "default": 8766,
          "description": "ANA MAX MCP port used by the start command."
        },
        "anaMax.dashboardUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "ANA MAX Control Center dashboard endpoint."
        },
        "anaMax.codexServerName": {
          "type": "string",
          "default": "anamax",
          "description": "Codex MCP server name for the shared ANA MAX runtime."
        },
        "anaMax.antigravityServerName": {
          "type": "string",
          "default": "anamax",
          "description": "Antigravity/Qoder/Windsurf MCP server name for the shared ANA MAX runtime."
        }
      }
    }
  }
}
