@echo off
:: Windows Update Repair Launcher
:: Generated by ANA MAX OS-27
:: This script launches the PowerShell repair script with Administrator privileges

echo ====================================
echo WINDOWS UPDATE REPAIR
echo ====================================
echo.
echo This script requires Administrator privileges.
echo A UAC prompt will appear - please click YES.
echo.

:: Check if already running as admin
net session >nul 2>&1
if %errorLevel% == 0 (
    echo Already running as Administrator.
    echo.
    echo Launching repair script...
    echo.
    powershell -ExecutionPolicy Bypass -File "%~dp0repair_windows_update.ps1"
    pause
    exit /b
)

:: Request admin privileges
echo Requesting Administrator privileges...
powershell -Command "Start-Process powershell -ArgumentList '-ExecutionPolicy Bypass -File \"%~dp0repair_windows_update.ps1\"' -Verb RunAs"

:: If the above command failed, try alternative method
if %errorLevel% neq 0 (
    echo.
    echo Failed to launch with UAC. Please manually:
    echo 1. Right-click on this file
    echo 2. Select "Run as Administrator"
    echo.
    pause
)
