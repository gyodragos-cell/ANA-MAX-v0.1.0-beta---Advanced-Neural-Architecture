# Root environment example for the ANA MAX lab.
# Canonical runtime env stays in ANA_MAX\.env.

# OpenCode Zen or OpenAI Keys (comma separated for key rotation)
OPENCODE_ZEN_API_KEYS=sk-your-key-1,sk-your-key-2

# OpenRouter / Nemotron
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=ANA MAX Nemotron Runner

# Optional AI Backends
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

