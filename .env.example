# ANA MAX - Environment Variables Template
# Copy this file to .env and fill in your values

# OpenCode Zen API (primary backend)
OPENCODE_ZEN_API_KEY=your_api_key_here
OPENCODE_ZEN_MODEL=big-pickle

# Ollama (local AI - optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# OpenRouter (fallback models)
OPENROUTER_API_KEY=your_api_key_here

# Gemini API (optional)
GEMINI_API_KEY=your_api_key_here

# MCP Server Configuration
MCP_PORT=8765
MCP_HOST=127.0.0.1
MCP_API_KEY=change-me

# Browser workflows
# Chrome is recommended for visible local browser workflows on Windows.
ANA_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
