{
  "connections": {
    "ollama_to_mcp": {
      "enabled": true,
      "endpoint": "http://localhost:11434",
      "mcp_config": "config/mcp_ana_max_agent.json",
      "sync_interval": 30
    },
    "openrouter_to_mcp": {
      "enabled": true,
      "endpoint": "https://openrouter.ai/api/v1",
